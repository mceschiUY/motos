{
  "permissions": {
    "allow": [
      "Bash(dotnet build*)",
      "Bash(dotnet run*)",
      "Bash(dotnet test*)",
      "Bash(npx ng build*)",
      "Bash(npx ng serve*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker ps*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(dotnet build*)",
      "PowerShell(dotnet run*)",
      "PowerShell(dotnet test*)",
      "PowerShell(npx ng build*)",
      "PowerShell(npx ng serve*)",
      "PowerShell(npm ci)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "deny": [
      "Read(./**/bin/**)",
      "Read(./**/obj/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/package-lock.json)",
      "Read(./web/.angular/**)",
      "Read(./web/dist/**)",
      "Read(./.git/**)"
    ]
  }
}
